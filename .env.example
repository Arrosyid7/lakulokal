# Konfigurasi publik/default proyek
# Salin file ini ke .env dan isi permintaan asli untuk deployment publik.
# Untuk deploy publik, isi PUBLIC_BASE_URL / APP_BASE_URL / SITE_URL dengan domain yang benar.

# ── Aplikasi / publik ─────────────────────────────────────────────────────
APP_NAME=lakulokal
APP_MODE=public
PUBLIC_BASE_URL=https://lakulokal.id
APP_BASE_URL=https://lakulokal.id
SITE_URL=https://lakulokal.id

# ── Groq API (GRATIS) ─────────────────────────────────────────────────────
# Daftar di: https://console.groq.com → Settings → API Keys → Create
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# ── DOKU Payment Gateway ─────────────────────────────────────────────────
# Isi credential asli dari dashboard DOKU kamu. Callback utama harus mengarah ke:
# https://lakulokal.id/sukses.html?order_id={order_id}
DOKU_CLIENT_ID=your_doku_client_id
DOKU_SECRET_KEY=your_doku_secret_key
DOKU_BASE_URL=https://api.doku.com
DOKU_WEBHOOK_SECRET=replace_with_random_secret_token

# ── Supabase ───────────────────────────────────────────────────────────────
# Ambil dari project Supabase kamu. Untuk production, gunakan service role key
# yang aman dan batasi akses sesuai kebutuhan.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Redis / worker (opsional untuk produksi) ──────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Port server ───────────────────────────────────────────────────────────
PORT=5000
