# Copy to .env.local for local Next.js development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# DANA SNAP Payment Gateway. X_PARTNER_ID from DANA is the Partner ID.
DANA_ENV=sandbox
DANA_PARTNER_ID=your_dana_partner_id
# Keep PEM newlines escaped as \n. This key signs server requests to DANA.
DANA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----
DANA_MERCHANT_ID=your_dana_merchant_id
DANA_MCC=your_dana_assigned_mcc
# Production only: DANA's public key for Finish Notify signature verification.
DANA_PUBLIC_KEY=
DANA_ORIGIN=https://api.sandbox.dana.id
DANA_DEBUG=false

# Cloud Run API. The service account JSON is a server-side secret and must not be exposed to NEXT_PUBLIC variables.
GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project
GOOGLE_CLOUD_REGION=asia-southeast2
CLOUD_RUN_JOB_NAME=lakulokal-video-worker
GOOGLE_SERVICE_ACCOUNT_JSON=
MAX_CONCURRENT_JOBS=2
MAX_VIDEO_DURATION=7200
MAX_CLIPS_PER_ORDER=20
RESULT_EXPIRATION_HOURS=72

# Worker credentials and Supabase Storage private bucket.
SUPABASE_URL=https://your-project.supabase.co
STORAGE_BUCKET=lakulokal-results

# Protects scheduled payment reconciliation and result cleanup.
CRON_SECRET=replace_with_a_long_random_secret
