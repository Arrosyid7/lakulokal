# Copy to .env.local for local Next.js development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# DANA Merchant Portal credentials for DANA QRIS API payment.
DANA_ENVIRONMENT=sandbox
DANA_API_URL=https://api.sandbox.dana.id
DANA_CLIENT_ID=your_dana_client_id
# Client Secret is issued by the portal but is not used by this SNAP asymmetric-signature flow.
DANA_CLIENT_SECRET=
# Keep PEM newlines escaped as \n. This key signs server requests to DANA.
DANA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----
DANA_MERCHANT_ID=your_dana_merchant_id
DANA_MCC=your_dana_assigned_mcc
# External Shop ID from DANA Sandbox Submerchants. Required for QRIS.
DANA_EXTERNAL_STORE_ID=your_dana_external_store_id
# Production only: DANA's public key for Finish Notify signature verification.
DANA_PUBLIC_KEY=
DANA_DEBUG=false

# Protects scheduled payment reconciliation and result cleanup.
CRON_SECRET=replace_with_a_long_random_secret
